# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Bağımlılık döngüsü sorununu gidermek için deterministic_uuids ve generate_multiple_pod_projects kapatıldı
install! 'cocoapods',
         :disable_input_output_paths => true,
         :deterministic_uuids => false

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # BoringSSL için flag düzeltmesi
      if target.name == 'BoringSSL-GRPC'
        config.build_settings['OTHER_CFLAGS'] ||= ['$(inherited)']
        config.build_settings['OTHER_CFLAGS'].delete('-G')
      end
      
      # gRPC-Core header path düzeltmesi
      if target.name == 'gRPC-Core'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
        config.build_settings['HEADER_SEARCH_PATHS'] << '"${PODS_TARGET_SRCROOT}"'
        config.build_settings['HEADER_SEARCH_PATHS'] << '"${PODS_TARGET_SRCROOT}/include"'
      end
      
      # iOS deployment target ayarı
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'

      # Bağımlılık döngüsünü çözmek için:
      # abseil, leveldb-library ve GoogleUserMessagingPlatform target'larının
      # paralel build özelliğini kapatıyoruz.
      # Bu, Xcode'un build sıralamasını kendi belirlemesini sağlar.
      if ['abseil', 'leveldb-library', 'GoogleUserMessagingPlatform', 
          'GoogleUserMessagingPlatform-UserMessagingPlatformResources',
          'video_player_avfoundation'].include?(target.name)
        config.build_settings['SWIFT_INSTALL_OBJC_HEADER'] = 'NO'
      end
    end

    # Döngüye giren target'ların birbirinden bağımsız olarak build edilmesini sağla
    # Bu ayar, Xcode'un bu target'ların build sırasını doğru belirlemesine yardımcı olur
    if target.name == 'abseil'
      target.build_phases.each do |phase|
        if phase.is_a?(Xcodeproj::Project::Object::PBXCopyFilesBuildPhase) ||
           phase.is_a?(Xcodeproj::Project::Object::PBXHeadersBuildPhase)
          phase.run_only_for_deployment_postprocessing = '0'
        end
      end
    end
  end

  # Pods projesindeki tüm scheme'lerin paralel build'ini devre dışı bırak
  # Bu, bağımlılık döngüsünü engelleyen en etkili yöntemdir
  installer.pods_project.build_configuration_list.build_configurations.each do |config|
    config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
  end
end